{
  "name": "hostforge-database-gateway-client-smoke",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "smoke": "npm run smoke:pg && npm run smoke:drizzle && npm run generate --silent && npm run smoke:prisma",
    "smoke:drizzle": "node smoke-drizzle.mjs",
    "smoke:pg": "node smoke-pg.mjs",
    "smoke:prisma": "tsx smoke-prisma.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "prisma": "6.19.3",
    "tsx": "4.23.1"
  },
  "engines": {
    "node": ">=22"
  }
}
