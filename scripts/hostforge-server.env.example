# HostForge server environment (copy to /etc/hostforge/hostforge.env and fill values).
# File permissions: root:hostforge 640 recommended. Never commit real secrets.

# Required: management API bearer token (CLI and scripts use Authorization: Bearer)
HOSTFORGE_API_TOKEN=

# Required: HMAC key for signed UI session cookies (min 16 characters)
HOSTFORGE_SESSION_SECRET=

# Required bootstrap webhook secret. After GitHub App setup, HostForge verifies
# deliveries against the App's sealed webhook secret first.
HOSTFORGE_WEBHOOK_SECRET=

# Required for GitHub App setup, encrypted environment variables, managed
# database credentials, backup destinations, and wrapped backup data keys.
# AES-256 key (base64 of 32 bytes: openssl rand -base64 32) that seals variable
# values and GitHub App credentials at rest in SQLite.
# Losing this key makes sealed values unreadable; set a new key and re-enter them.
# HOSTFORGE_ENV_ENCRYPTION_KEY=

# Bind address. Production: keep on loopback and reverse-proxy or SSH-tunnel the UI/API.
HOSTFORGE_LISTEN=127.0.0.1:8080

# Persistent state (SQLite, worktrees, Railpack artifacts, and logs)
HOSTFORGE_DATA_DIR=/var/lib/hostforge

# Required Railpack/BuildKit deployment path. HostForge checks the pinned helper,
# local BuildKit daemon, Docker, and artifact storage at startup.
HOSTFORGE_RAILPACK_ENABLED=true
# HOSTFORGE_RAILPACK_BIN=/usr/local/bin/railpack
# HOSTFORGE_RAILPACK_VERSION=v0.23.0
# Must be an immutable digest, never a mutable tag such as :latest.
# HOSTFORGE_RAILPACK_FRONTEND_IMAGE=ghcr.io/railwayapp/railpack-frontend@sha256:<digest>
# HOSTFORGE_BUILDKIT_BIN=/usr/local/bin/buildctl
# HOSTFORGE_BUILDKIT_ADDRESS=unix:///run/buildkit/buildkitd.sock
# HOSTFORGE_RAILPACK_ARTIFACTS_DIR=/var/lib/hostforge/railpack
# HOSTFORGE_RAILPACK_BUILD_CONCURRENCY=1
# HOSTFORGE_RAILPACK_MIN_FREE_DISK_BYTES=10737418240
# Blocks database provisioning, backup, and restore under host disk pressure.
# HOSTFORGE_DATABASE_MIN_FREE_DISK_BYTES=5368709120
# Bounds persistent database jobs and backup/restore queue admission.
# Start with one worker on small VPS hosts; increase only after measuring I/O and memory pressure.
# HOSTFORGE_DATABASE_OPERATION_CONCURRENCY=1
# HOSTFORGE_DATABASE_TRANSFER_MAX_PER_HOUR=60

# Public database gateways are deliberately disabled for the first staging
# rollout. Before enabling, configure a digest-pinned PgBouncer image whose
# declared version is >=1.25.2, contains both pgbouncer and psql executables,
# and point postgres.<platform-domain> at this VPS.
HOSTFORGE_DATABASE_GATEWAYS_ENABLED=false
# HOSTFORGE_POSTGRES_GATEWAY_IMAGE=registry.example/pgbouncer@sha256:<digest>
# HOSTFORGE_POSTGRES_GATEWAY_VERSION=1.25.2
# HOSTFORGE_DATABASE_GATEWAY_OPERATION_CONCURRENCY=1
# Caddy storage discovery is preferred. Explicit files are available for
# installations whose Caddy storage layout differs from the standard layout.
# HOSTFORGE_POSTGRES_GATEWAY_CERT_FILE=/secure/path/postgres.example.test.crt
# HOSTFORGE_POSTGRES_GATEWAY_KEY_FILE=/secure/path/postgres.example.test.key

# Per-IP webhook requests per minute (must be > 0)
HOSTFORGE_WEBHOOK_RATE_LIMIT_PER_MINUTE=60

# Optional: DNS hints in UI / domain APIs (auto-detect public IP if unset)
# HOSTFORGE_DNS_SERVER_IPV4=203.0.113.50
# HOSTFORGE_DNS_SERVER_IPV6=2001:db8::1
# HOSTFORGE_DNS_DETECT_URL=https://api.ipify.org
# HOSTFORGE_DNS_DETECT_IPV6_URL=https://api64.ipify.org
# HOSTFORGE_DNS_DETECT_TIMEOUT_MS=2500
# HOSTFORGE_DOMAIN_SYNC_AFTER_MUTATE=true

# Optional overrides
# HOSTFORGE_SESSION_COOKIE_NAME=hostforge_session
# HOSTFORGE_SESSION_TTL_MINUTES=720
# HOSTFORGE_SESSION_COOKIE_SECURE=true
# HOSTFORGE_WEBHOOK_BASE_PATH=/hooks/github
# HOSTFORGE_CADDY_ROOT_CONFIG=/etc/caddy/Caddyfile
# HOSTFORGE_SYNC_CADDY=true
# One-time wildcard platform domain base. With *.apps.example.com pointed at the VPS,
# new application environments can receive managed hostnames automatically.
# HOSTFORGE_PLATFORM_DOMAIN_BASE=apps.example.com
# Snippet path (default: <HOSTFORGE_DATA_DIR>/caddy/hostforge.caddy). If systemd runs Caddy as user
# `caddy`, do NOT put the snippet only under /var/lib/hostforge or a 700 home â€” use e.g.:
#   HOSTFORGE_CADDY_GENERATED_PATH=/etc/caddy/hostforge.d/hostforge.caddy
#   HOSTFORGE_CADDY_CONTROL_PLANE_PATH=/etc/caddy/hostforge.d/control-plane.caddy
# and in /etc/caddy/Caddyfile: import that path. Then fix permissions once:
#   sudo mkdir -p /etc/caddy/hostforge.d
#   sudo chown root:caddy /etc/caddy/hostforge.d && sudo chmod 2770 /etc/caddy/hostforge.d
#   sudo usermod -aG caddy hostforge   # operator who runs CLI sync; re-login
# New files in that dir pick up group `caddy` (setgid); ensure hostforge.caddy is g+r (e.g. 0640).

# Optional: mirror leaf cert hints into SQLite (domains.last_cert_message / cert_checked_at). 0 = disabled.
# HOSTFORGE_CADDY_CERT_POLL_INTERVAL_SEC=300
# HOSTFORGE_CADDY_ADMIN=http://127.0.0.1:2019
# Caddy storage root for PEM scans (Debian package often uses /var/lib/caddy; user installs may use ~/.local/share/caddy)
# HOSTFORGE_CADDY_STORAGE_ROOT=/var/lib/caddy

# One-time HTTPS-only public-IP onboarding. The Ubuntu bootstrapper fills these.
# Keep the server itself bound to 127.0.0.1; Caddy is the only public listener.
# HOSTFORGE_BOOTSTRAP_ENABLED=false
# HOSTFORGE_BOOTSTRAP_PUBLIC_IP=203.0.113.50
# HOSTFORGE_BOOTSTRAP_HTTPS_PORT=443
# HOSTFORGE_BOOTSTRAP_EXPIRES_AT=2026-08-01T00:00:00Z
